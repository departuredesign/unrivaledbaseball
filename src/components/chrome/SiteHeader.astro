---
import { liveOnly, WAYS_TO_PLAY, TOP_NAV } from '../../lib/phase';

interface Props {
  activeNav?: 'home' | 'ways-to-play' | 'venues' | 'events' | 'stories' | 'about';
}
const { activeNav } = Astro.props;

const pillars = liveOnly(WAYS_TO_PLAY);
const topNav = liveOnly(TOP_NAV);
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__logo" href="/" aria-label="Unrivaled Baseball — Home">
      <img class="site-header__logo-img" src="/images/logo.png" alt="Unrivaled Baseball" width="74" height="44" />
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <div class="nav-dropdown">
        <button class="nav-link" aria-expanded="false">
          Ways to Play
          <span aria-hidden="true">▾</span>
        </button>
        <div class="nav-dropdown__menu" role="menu">
          {pillars.map(p => (
            <a class="nav-dropdown__item" role="menuitem" href={`/${p.slug}/`}>
              <span class="pillar-dot" data-pillar={p.pillar} aria-hidden="true"></span>
              <span class="nav-dropdown__item-content">
                <span class="nav-dropdown__item-name">{p.name}</span>
                <span class="nav-dropdown__item-meta">{p.meta}</span>
              </span>
            </a>
          ))}
        </div>
      </div>
      {topNav.map(l => (
        <a class="nav-link" class:list={[{ 'is-active': activeNav === l.key }]} href={l.href}>{l.label}</a>
      ))}
    </nav>

    <a class="nav-cta" href="/events/">Start Planning</a>

    <button class="site-header__burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
      <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>
  </div>

  {/* ===== Mobile full-screen overlay (slides in from right) =====
       Adapted from the unrivaledsports.com corporate pattern: gold→navy,
       Review Poster→Baseball's display-poster, stagger animation kept,
       footer block carries the Start Planning CTA + a contact email. */}
  <div class="mobile-menu" id="mobile-menu" data-open="false" aria-hidden="true">
    <div class="mobile-menu__overlay">
      <div class="mobile-menu__header">
        <a class="mobile-menu__logo" href="/" aria-label="Unrivaled Baseball — Home">
          <img src="/images/logo.png" alt="" width="56" height="34" />
        </a>
        <button class="mobile-menu__close" type="button" aria-label="Close menu"></button>
      </div>
      <nav class="mobile-menu__nav" aria-label="Mobile">
        {/* Pillars are wrapped in a collapsible "Ways to Play" group so the
            mobile menu mirrors the desktop dropdown hierarchy 1:1. Collapsed
            by default; tap the trigger to reveal the 4 pillars with their
            meta lines (UBN · USSSA-sanctioned play, etc.). */}
        <div class="mobile-menu__group" data-expanded="false">
          <button class="mobile-menu__group-trigger" type="button"
                  aria-expanded="false" aria-controls="mobile-menu-pillars">
            <span>Ways to Play</span>
            <svg class="mobile-menu__chevron" viewBox="0 0 24 24"
                 width="26" height="26" aria-hidden="true">
              <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.5"
                    fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="mobile-menu__sublist" id="mobile-menu-pillars"
               role="region" aria-label="Ways to Play">
            {pillars.map(p => (
              <a class="mobile-menu__subitem" href={p.href}>
                <span class="pillar-dot" data-pillar={p.pillar} aria-hidden="true"></span>
                <span class="mobile-menu__subitem-text">
                  <span class="mobile-menu__subitem-name">{p.name}</span>
                  <span class="mobile-menu__subitem-meta">{p.meta}</span>
                </span>
              </a>
            ))}
          </div>
        </div>
        {topNav.map(l => <a class="mobile-menu__item" href={l.href}>{l.label}</a>)}
      </nav>
      <div class="mobile-menu__footer">
        <a class="mobile-menu__cta" href="/events/">
          <span>Start Planning</span>
          <span aria-hidden="true">→</span>
        </a>
        <div class="mobile-menu__contact">
          <p class="mobile-menu__contact-label">Contact</p>
          <a class="mobile-menu__contact-email" href="mailto:hello@unrivaledbaseball.com">hello@unrivaledbaseball.com</a>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  (function () {
    var header = document.querySelector('.site-header');
    if (!header) return;
    var burger = header.querySelector('.site-header__burger');
    var menu   = header.querySelector('.mobile-menu');
    if (!burger || !menu) return;
    var close  = menu.querySelector('.mobile-menu__close');
    var links  = menu.querySelectorAll('a');

    function setOpen(open) {
      menu.setAttribute('data-open', open ? 'true' : 'false');
      menu.setAttribute('aria-hidden', open ? 'false' : 'true');
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
      burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      document.body.classList.toggle('menu-open', open);
      // Reset any expanded groups when the overlay closes, so the next
      // open shows the menu in its collapsed default state.
      if (!open) {
        Array.prototype.forEach.call(menu.querySelectorAll('.mobile-menu__group'), function (g) {
          g.setAttribute('data-expanded', 'false');
          var t = g.querySelector('.mobile-menu__group-trigger');
          if (t) t.setAttribute('aria-expanded', 'false');
        });
      }
    }

    burger.addEventListener('click', function () {
      var isOpen = menu.getAttribute('data-open') === 'true';
      setOpen(!isOpen);
    });
    if (close) close.addEventListener('click', function () { setOpen(false); });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && menu.getAttribute('data-open') === 'true') setOpen(false);
    });

    // Expand/collapse triggers for any nested groups (Ways to Play).
    Array.prototype.forEach.call(menu.querySelectorAll('.mobile-menu__group'), function (group) {
      var trigger = group.querySelector('.mobile-menu__group-trigger');
      if (!trigger) return;
      trigger.addEventListener('click', function () {
        var expanded = group.getAttribute('data-expanded') === 'true';
        group.setAttribute('data-expanded', expanded ? 'false' : 'true');
        trigger.setAttribute('aria-expanded', expanded ? 'false' : 'true');
      });
    });

    // Close after the user taps a destination, so back-nav feels normal.
    Array.prototype.forEach.call(links, function (a) {
      a.addEventListener('click', function () { setOpen(false); });
    });
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-white);
    border-bottom: 1px solid var(--gray-200);
  }
  .site-header__inner {
    max-width: var(--page-max-width);
    margin: 0 auto;
    padding: 14px var(--margin-mobile);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  @media (min-width: 1024px) {
    .site-header__inner { padding: 16px var(--margin-desktop); }
  }
  .site-header__logo {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    height: 44px;
  }
  .site-header__logo-img {
    height: 44px;
    width: auto;
    display: block;
  }

  .site-header__nav {
    display: none;
    gap: 32px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .site-header__nav { display: flex; }
  }

  .nav-link {
    font-family: var(--font-body);
    font-size: var(--fs-meta);
    font-weight: var(--weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-navy);
    padding: 4px 0;
    border-bottom: 2px solid transparent;
    transition: color var(--transition-fast), border-color var(--transition-fast);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .nav-link:hover {
    color: var(--color-red);
  }
  .nav-link.is-active {
    border-bottom-color: var(--color-red);
  }

  .nav-dropdown {
    position: relative;
  }
  /* Invisible hover bridge across the 12px gap between the trigger and the
     menu. Without this, moving the cursor down from "Ways to Play" toward
     a menu item leaves .nav-dropdown's hit area and the menu closes before
     the cursor reaches it. The bridge is part of .nav-dropdown's tree so
     hovering it keeps .nav-dropdown:hover true.

     Width must cover the MENU's footprint, not just the trigger — the
     menu is min-width 320px and left-aligned to the trigger, so a
     diagonal cursor path lands outside a trigger-width bridge. We size
     to 340px (menu width + 20px forgiveness). */
  .nav-dropdown::after {
    content: '';
    position: absolute;
    top: 100%;
    left: -8px;
    width: 340px;
    height: 16px;
    /* pointer-events: auto (default) — captures hover, extends hit area. */
  }
  .nav-dropdown__menu {
    display: none;
    position: absolute;
    top: calc(100% + 12px);
    left: 0;
    min-width: 320px;
    background: var(--color-white);
    border: 1px solid var(--gray-200);
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    padding: 8px 0;
    z-index: 10;
  }
  .nav-dropdown:hover .nav-dropdown__menu,
  .nav-dropdown:focus-within .nav-dropdown__menu,
  .nav-dropdown__menu:hover {
    display: block;
  }
  .nav-dropdown__item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 20px;
    font-size: var(--fs-body-sm);
    color: var(--color-navy);
    transition: background var(--transition-fast), color var(--transition-fast);
  }
  .nav-dropdown__item:hover {
    background: var(--gray-50);
    color: var(--color-red);
  }
  .nav-dropdown__item .pillar-dot {
    margin-top: 6px;
  }
  .nav-dropdown__item-content {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .nav-dropdown__item-name {
    font-weight: var(--weight-semibold);
  }
  .nav-dropdown__item-meta {
    font-size: var(--fs-meta);
    color: var(--gray-500);
    font-weight: var(--weight-regular);
    letter-spacing: 0.02em;
  }

  .nav-cta {
    flex-shrink: 0;
    padding: 9px 18px;
    background: var(--color-navy);
    color: var(--color-white);
    font-family: var(--font-body);
    font-size: var(--fs-meta);
    font-weight: var(--weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background var(--transition-fast);
  }
  .nav-cta:hover {
    background: var(--color-red);
  }

  .pillar-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
    background: var(--pillar, var(--gray-400));
  }

  /* ===== Mobile hamburger + drawer (<1024px) ===== */
  .site-header__burger {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 9px;
    background: none;
    border: none;
    cursor: pointer;
    flex-shrink: 0;
  }
  .site-header__burger span {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--color-navy);
  }
  @media (min-width: 1024px) {
    .site-header__burger { display: none; }
  }

  /* ===== Mobile full-screen overlay menu ===== */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 200;
    pointer-events: none;
  }
  .mobile-menu[data-open="true"] {
    pointer-events: auto;
  }
  @media (min-width: 1024px) {
    .mobile-menu { display: none; }
  }

  .mobile-menu__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    background: var(--color-navy);
    color: var(--color-white);
    padding: 22px 24px 32px;
    overflow-y: auto;
    transform: translateX(100%);
    transition: transform 400ms cubic-bezier(0.42, 0, 0.58, 1);
  }
  .mobile-menu[data-open="true"] .mobile-menu__overlay {
    transform: translateX(0);
  }

  .mobile-menu__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
  }
  .mobile-menu__logo img {
    height: 34px;
    width: auto;
    display: block;
    filter: brightness(0) invert(1); /* white wordmark on navy */
  }
  .mobile-menu__close {
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    position: relative;
    flex-shrink: 0;
  }
  .mobile-menu__close::before,
  .mobile-menu__close::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 28px;
    height: 2px;
    background: var(--color-white);
  }
  .mobile-menu__close::before { transform: translate(-50%, -50%) rotate(45deg); }
  .mobile-menu__close::after  { transform: translate(-50%, -50%) rotate(-45deg); }

  .mobile-menu__nav {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 40px 0 28px;
  }
  /* Shared base for top-level poster items AND the Ways-to-Play group trigger. */
  .mobile-menu__item,
  .mobile-menu__group-trigger {
    display: block;
    padding: 22px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    font-family: var(--font-display-poster);
    font-weight: var(--weight-poster-heavy);
    font-size: clamp(44px, 12.5vw, 72px);
    line-height: 0.95;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--color-white);
    text-decoration: none;
    transition: color 150ms ease;
  }
  /* The About row sits below the group — give it a closing bottom rule. */
  .mobile-menu__item:last-child {
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
  }
  .mobile-menu__item:hover,
  .mobile-menu__item:focus-visible,
  .mobile-menu__group-trigger:hover,
  .mobile-menu__group-trigger:focus-visible {
    color: var(--color-red);
  }

  /* Ways-to-Play group: collapsible trigger + sublist. */
  .mobile-menu__group-trigger {
    /* Button reset — keep only the borders we want from the shared rule. */
    background: transparent;
    border-left: 0;
    border-right: 0;
    border-bottom: 0;
    width: 100%;
    text-align: left;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .mobile-menu__chevron {
    flex-shrink: 0;
    transition: transform 250ms ease;
  }
  .mobile-menu__group[data-expanded="true"] .mobile-menu__chevron {
    transform: rotate(180deg);
  }

  .mobile-menu__sublist {
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transition: max-height 350ms ease, opacity 200ms ease;
  }
  .mobile-menu__group[data-expanded="true"] .mobile-menu__sublist {
    max-height: 480px; /* enough for 4 sub-items at the largest viewport */
    opacity: 1;
  }

  .mobile-menu__subitem {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 16px 0 16px 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--color-white);
    text-decoration: none;
    transition: color 150ms ease, padding-left 150ms ease;
  }
  .mobile-menu__subitem:first-child { border-top: 0; }
  .mobile-menu__subitem:hover,
  .mobile-menu__subitem:focus-visible {
    color: var(--color-red);
    padding-left: 14px;
  }
  .mobile-menu__subitem .pillar-dot {
    margin-top: 14px; /* aligns with the cap-height of the sub-name */
    width: 10px;
    height: 10px;
  }
  .mobile-menu__subitem-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .mobile-menu__subitem-name {
    font-family: var(--font-display-poster);
    font-weight: var(--weight-poster-heavy);
    font-size: clamp(24px, 6.5vw, 36px);
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }
  .mobile-menu__subitem-meta {
    font-family: var(--font-body);
    font-weight: var(--weight-regular);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }

  /* Stagger top-level items in when the overlay opens. */
  .mobile-menu[data-open="true"] .mobile-menu__group-trigger,
  .mobile-menu[data-open="true"] .mobile-menu__item {
    animation: mobile-menu-item-in 400ms cubic-bezier(0.25, 0.1, 0.25, 1) both;
  }
  .mobile-menu[data-open="true"] .mobile-menu__group-trigger { animation-delay: 100ms; }
  .mobile-menu[data-open="true"] .mobile-menu__item:nth-child(2) { animation-delay: 150ms; }
  .mobile-menu[data-open="true"] .mobile-menu__item:nth-child(3) { animation-delay: 200ms; }
  .mobile-menu[data-open="true"] .mobile-menu__item:nth-child(4) { animation-delay: 250ms; }
  .mobile-menu[data-open="true"] .mobile-menu__item:nth-child(5) { animation-delay: 300ms; }
  @keyframes mobile-menu-item-in {
    from { opacity: 0; transform: translateX(28px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  /* Stagger sub-items in when the group expands. */
  .mobile-menu__group[data-expanded="true"] .mobile-menu__subitem {
    animation: mobile-menu-subitem-in 350ms cubic-bezier(0.25, 0.1, 0.25, 1) both;
  }
  .mobile-menu__group[data-expanded="true"] .mobile-menu__subitem:nth-child(1) { animation-delay: 80ms; }
  .mobile-menu__group[data-expanded="true"] .mobile-menu__subitem:nth-child(2) { animation-delay: 130ms; }
  .mobile-menu__group[data-expanded="true"] .mobile-menu__subitem:nth-child(3) { animation-delay: 180ms; }
  .mobile-menu__group[data-expanded="true"] .mobile-menu__subitem:nth-child(4) { animation-delay: 230ms; }
  @keyframes mobile-menu-subitem-in {
    from { opacity: 0; transform: translateX(20px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  .mobile-menu__footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    flex-shrink: 0;
    flex-wrap: wrap;
  }
  .mobile-menu__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 22px;
    background: var(--color-red);
    color: var(--color-white);
    font-family: var(--font-body);
    font-weight: var(--weight-bold);
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 150ms ease, color 150ms ease;
  }
  .mobile-menu__cta:hover {
    background: var(--color-white);
    color: var(--color-navy);
  }
  .mobile-menu__contact {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: right;
  }
  .mobile-menu__contact-label {
    margin: 0;
    font-family: var(--font-body);
    font-weight: var(--weight-bold);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }
  .mobile-menu__contact-email {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--color-white);
    text-decoration: none;
  }
  .mobile-menu__contact-email:hover { color: var(--color-red); }

  /* Lock background scroll while the overlay is open — applied to <body>
     by the script so the menu is the only thing the user can interact with. */
  :global(body.menu-open) { overflow: hidden; }
</style>
