---
import { FOOTER, liveOnly } from '../../lib/phase';

const rawColumns = [
  { heading: 'WAYS TO PLAY', links: FOOTER.waysToPlay },
  { heading: 'PROPERTIES',   links: FOOTER.properties },
  { heading: 'FOR YOU',      links: FOOTER.forYou },
  { heading: 'COMPANY',      links: FOOTER.company },
];
// Filter each column to currently-live links, and drop columns that empty out.
const columns = rawColumns
  .map(c => ({ heading: c.heading, links: liveOnly(c.links) }))
  .filter(c => c.links.length > 0);
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <a href="/" class="site-footer__logo" aria-label="Unrivaled Baseball — Home">
        <img class="site-footer__logo-img" src="/images/logo.png" alt="Unrivaled Baseball" width="141" height="84" />
      </a>
      <p class="site-footer__tag text-body-sm">Your youth baseball journey lives here.</p>
    </div>

    <nav class="site-footer__columns" aria-label="Footer">
      {columns.map(col => (
        <div class="site-footer__col">
          <h3 class="site-footer__heading text-eyebrow">{col.heading}</h3>
          <ul class="site-footer__list">
            {col.links.map(link => (
              <li><a class="site-footer__link" href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>

  <div class="site-footer__base">
    <p class="text-meta">© 2026 Unrivaled Baseball. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-navy);
    color: var(--color-white);
    width: 100%;
  }
  .site-footer__inner {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 56px var(--margin-mobile) 32px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  @media (min-width: 1024px) {
    .site-footer__inner {
      padding: 64px var(--margin-desktop) 32px;
      flex-direction: row;
      align-items: flex-start;
      gap: 64px;
    }
  }

  .site-footer__brand {
    flex: 1;
    max-width: 320px;
  }
  .site-footer__logo {
    display: inline-block;
    margin-bottom: 16px;
  }
  .site-footer__logo-img {
    height: 84px;
    width: auto;
    display: block;
    /* Footer is navy; tint logo to white */
    filter: brightness(0) invert(1);
  }
  .site-footer__tag {
    opacity: 0.6;
    max-width: 240px;
  }

  .site-footer__columns {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    flex: 2;
  }
  @media (min-width: 1024px) {
    .site-footer__columns {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .site-footer__heading {
    opacity: 0.5;
    margin-bottom: 14px;
  }
  .site-footer__list { display: flex; flex-direction: column; gap: 8px; }
  .site-footer__link {
    font-family: var(--font-body);
    font-size: var(--fs-meta);
    opacity: 0.85;
    transition: opacity var(--transition-fast), color var(--transition-fast);
  }
  .site-footer__link:hover {
    opacity: 1;
    color: var(--color-red);
  }

  .site-footer__base {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding: 20px var(--margin-mobile);
    text-align: center;
    color: rgba(255, 255, 255, 0.5);
  }
  @media (min-width: 1024px) {
    .site-footer__base { padding: 20px var(--margin-desktop); }
  }
</style>
