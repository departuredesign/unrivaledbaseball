---
import Breadcrumb from '../atoms/Breadcrumb.astro';
import PillarTag from '../atoms/PillarTag.astro';

interface Props {
  parentLabel: string;
  parentHref: string;
  parentPillar: 'destinations' | 'training';
  headline: string;
  sub?: string;
}
const { parentLabel, parentHref, parentPillar, headline, sub } = Astro.props;
---

<section class="sub-page-hero">
  <div class="sub-page-hero__overlay" aria-hidden="true"></div>
  <div class="sub-page-hero__inner">
    <Breadcrumb
      theme="dark"
      items={[
        { label: 'Unrivaled Baseball', href: '/' },
        { label: parentLabel, href: parentHref },
      ]}
    />
    <PillarTag pillar={parentPillar} label={parentLabel} color="white" />
    <h1 class="sub-page-hero__headline text-hero">{headline}</h1>
    {sub && <p class="sub-page-hero__sub text-body">{sub}</p>}
  </div>
</section>

<style>
  .sub-page-hero {
    position: relative;
    background: var(--color-navy);
    color: var(--color-white);
    min-height: 480px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .sub-page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 70% 30%, rgba(255,255,255,0.06), transparent 60%);
    z-index: 1;
  }
  .sub-page-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(29,36,104,0.95) 0%, rgba(0,0,0,0.6) 100%);
    z-index: 0;
  }
  .sub-page-hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 80px var(--margin-mobile);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  @media (min-width: 1024px) {
    .sub-page-hero__inner { padding: 100px var(--margin-desktop); }
  }
  .sub-page-hero__headline {
    max-width: 1100px;
  }
  .sub-page-hero__sub {
    max-width: 720px;
    opacity: 0.85;
  }
</style>
