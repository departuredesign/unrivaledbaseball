---
import PillarTag from '../atoms/PillarTag.astro';

interface Props {
  pillar: 'local' | 'destinations' | 'training' | 'nationals';
  tag: string;
  headline: string;
  sub?: string;
}
const { pillar, tag, headline, sub } = Astro.props;
// Nationals (gold) needs dark text for contrast; others use white
const isLight = pillar === 'nationals';
---

<section class="pillar-hero" data-pillar={pillar} data-text={isLight ? 'dark' : 'light'}>
  <div class="pillar-hero__pattern" aria-hidden="true"></div>
  <div class="pillar-hero__inner">
    <PillarTag pillar={pillar} label={tag} color={isLight ? 'black' : 'white'} />
    <h1 class="pillar-hero__headline text-hero">{headline}</h1>
    {sub && <p class="pillar-hero__sub text-body">{sub}</p>}
  </div>
</section>

<style>
  .pillar-hero {
    position: relative;
    overflow: hidden;
    background: var(--pillar);
    color: var(--color-white);
    min-height: 420px;
    display: flex;
    align-items: center;
  }
  .pillar-hero[data-text="dark"] {
    color: var(--color-black);
  }
  @media (min-width: 1024px) {
    .pillar-hero { min-height: 520px; }
  }

  /* Decorative pattern overlay (Pattern 1 / Velocity-style speed lines) */
  .pillar-hero__pattern {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      0deg,
      transparent 0px,
      transparent 3px,
      currentColor 3px,
      currentColor 4px
    );
    opacity: 0.08;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(90deg, black 0%, transparent 70%);
            mask-image: linear-gradient(90deg, black 0%, transparent 70%);
  }

  .pillar-hero__inner {
    position: relative;
    width: 100%;
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 80px var(--margin-mobile);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
  }
  @media (min-width: 1024px) {
    .pillar-hero__inner { padding: 100px var(--margin-desktop); }
  }
  .pillar-hero__headline {
    max-width: 1100px;
  }
  .pillar-hero__sub {
    max-width: 720px;
    opacity: 0.9;
  }
</style>
