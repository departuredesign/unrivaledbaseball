---
interface Props {
  pillar: 'local' | 'destinations' | 'training' | 'nationals';
  num: string;
  name: string;
  desc: string;
  href: string;
}
const { pillar, num, name, desc, href } = Astro.props;
const isLight = pillar === 'nationals';
---

<a class="pillar-card" data-pillar={pillar} data-text={isLight ? 'dark' : 'light'} href={href}>
  <span class="pillar-card__num text-eyebrow">{num}</span>
  <div class="pillar-card__body">
    <h3 class="pillar-card__name text-h3">{name}</h3>
    <p class="pillar-card__desc text-body-sm">{desc}</p>
    <span class="pillar-card__arrow" aria-hidden="true">→</span>
  </div>
</a>

<style>
  .pillar-card {
    aspect-ratio: 3 / 4;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 24px;
    background: var(--pillar);
    color: var(--color-white);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
    position: relative;
    overflow: hidden;
  }
  .pillar-card[data-text="dark"] {
    color: var(--color-black);
  }
  .pillar-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, rgba(255,255,255,0) 0%, rgba(0,0,0,0.15) 100%);
    pointer-events: none;
  }
  @media (hover: hover) {
    .pillar-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 32px rgba(0,0,0,0.2);
    }
  }
  .pillar-card__num {
    opacity: 0.7;
    position: relative;
    z-index: 1;
  }
  .pillar-card__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    position: relative;
    z-index: 1;
  }
  .pillar-card__name {
    font-family: var(--font-display);
    font-weight: var(--weight-poster-heavy);
    text-transform: uppercase;
  }
  .pillar-card__desc {
    opacity: 0.85;
  }
  .pillar-card__arrow {
    font-size: 22px;
    font-weight: var(--weight-bold);
    margin-top: 12px;
  }
</style>
