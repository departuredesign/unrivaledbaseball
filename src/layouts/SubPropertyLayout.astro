---
import BaseLayout from './BaseLayout.astro';
import '../styles/v4-pillar.css';
import '../styles/v4-subproperty.css';
import '../styles/v4-extra.css';

interface CsCardData {
  pillar: 'local' | 'destinations' | 'training' | 'ripken' | 'nationals';
  parentTag: string;
  name: string;
  meta?: string;
  href?: string;
}
interface Stat { label: string; value: string }
interface Event { pillar: 'local' | 'destinations' | 'training' | 'nationals' | 'ripken'; pillarLabel: string; month: string; day: string; title: string; loc: string; age: string; dates: string }
interface WteItem { title: string; desc: string }

interface Props {
  title: string;
  parentLabel: string;
  parentHref: string;
  parentPillar: 'destinations' | 'training';
  pageTitle: string;
  heroSub: string;
  heroPhoto?: string;
  stats: Stat[];
  storyHeadline: string;
  storyBody: string;
  storyPhoto?: string;
  upcomingEyebrow: string;
  upcomingHeadline: string;
  upcomingEvents: Event[];
  wtePillar: 'local' | 'destinations' | 'training' | 'nationals';
  wteHeadline: string;
  wteItems: WteItem[];
  galleryHeadline: string;
  continueCards: CsCardData[];
}

const {
  title, parentLabel, parentHref, parentPillar, pageTitle, heroSub,
  heroPhoto = '/images/v4/photo-dugout.png',
  stats, storyHeadline, storyBody,
  storyPhoto = '/images/v4/photo-running.png',
  upcomingEyebrow, upcomingHeadline, upcomingEvents,
  wteHeadline, wteItems, galleryHeadline, continueCards,
} = Astro.props;

const GALLERY = ['/images/v4/photo-flags.png', '/images/v4/photo-batter.png', '/images/v4/photo-pitcher.png', '/images/v4/photo-celebrate.png'];
---

<BaseLayout title={title} activeNav="ways-to-play" bodyClass="v4" transparentNav={true}>
  <div class="pillar-page" data-pillar={parentPillar}>

    <section class="phv4">
      <div class="phv4__bg" style={`background-image:url('${heroPhoto}')`} aria-hidden="true"></div>
      <div class="phv4__overlay" aria-hidden="true"></div>
      <div class="phv4__inner">
        <p class="phv4__eyebrow text-eyebrow">UNRIVALED BASEBALL / <a class="phv4__crumb" href={parentHref}>{parentLabel}</a></p>
        <span class="phv4__chip">{parentLabel}</span>
        <h1 class="phv4__headline">{pageTitle}</h1>
        <p class="phv4__sub">{heroSub}</p>
      </div>
    </section>

    <section class="aag">
      <div class="aag__inner">
        {stats.map(s => (
          <div class="aag__item"><span class="aag__label">{s.label}</span><span class="aag__value">{s.value}</span></div>
        ))}
      </div>
    </section>

    <section class="story">
      <div class="story__inner">
        <div>
          <p class="story__eyebrow text-eyebrow">THE STORY</p>
          <h2 class="story__headline">{storyHeadline}</h2>
          <p class="story__body text-body">{storyBody}</p>
        </div>
        <div class="story__photo" style={`background-image:url('${storyPhoto}')`} aria-hidden="true"></div>
      </div>
    </section>

    <section class="pevents" style="background:var(--gray-50)">
      <div class="sec__inner">
        <p class="sec__eyebrow text-eyebrow" style="color:var(--gray-500)">{upcomingEyebrow}</p>
        <h2 class="sec__headline">{upcomingHeadline}</h2>
        {upcomingEvents.map(e => (
          <div class="evrow">
            <span class="evrow__date"><span class="evrow__mon">{e.month}</span><span class="evrow__day">{e.day}</span></span>
            <span class="evrow__main"><h3 class="evrow__title">{e.title}</h3><span class="evrow__cat">{e.pillarLabel} · {e.age}</span></span>
            <span class="evrow__loc">{e.loc} · {e.dates}</span>
            <a class="evrow__reg" href="/events/">Register →</a>
          </div>
        ))}
      </div>
    </section>

    <section class="wte sec">
      <div class="sec__inner" style="display:flex;flex-direction:column;">
        <p class="sec__eyebrow text-eyebrow" style="color:var(--gray-500)">WHAT TO EXPECT</p>
        <h2 class="sec__headline">{wteHeadline}</h2>
        <div class="wte__grid">
          {wteItems.map(i => (
            <div class="wte-card"><h3 class="wte-card__title">{i.title}</h3><p class="wte-card__desc">{i.desc}</p></div>
          ))}
        </div>
      </div>
    </section>

    <section class="ngallery">
      <div class="ngallery__inner">
        <p class="ngallery__eyebrow text-eyebrow">GALLERY</p>
        <h2 class="ngallery__headline">{galleryHeadline}</h2>
        <div class="ngallery__grid">
          {GALLERY.map((src, i) => <span class="ngallery__tile" style={`background-image:url('${src}')`}><span class="ngallery__cap">[ on-site at {title} ]</span></span>)}
        </div>
      </div>
    </section>

    <section class="xsell xsell--gray">
      <div class="xsell__inner">
        <p class="xsell__eyebrow text-eyebrow">CONTINUE EXPLORING</p>
        <h2 class="xsell__headline">More from {parentLabel}.</h2>
        <div class="xsell__grid">
          {continueCards.map(c => (
            <a class="xcard" href={c.href}>
              <span class="xcard__tag">{c.parentTag}</span>
              <h3 class="xcard__name">{c.name}</h3>
              <p class="xcard__meta">{c.meta}</p>
              <span class="xcard__arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

  </div>
</BaseLayout>
