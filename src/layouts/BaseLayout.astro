---
import '../styles/fonts.css';
import '../styles/reset.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/motion.css';
import SiteHeader from '../components/chrome/SiteHeader.astro';
import SiteFooter from '../components/chrome/SiteFooter.astro';
import { isPageHidden } from '../lib/phase';

interface Props {
  title: string;
  description?: string;
  activeNav?: 'home' | 'ways-to-play' | 'venues' | 'events' | 'stories' | 'about';
  /** Extra CSS class(es) on <body> — used by variant pages to scope styles. */
  bodyClass?: string;
  /** When true, SiteHeader floats over the hero photo (homepage v4). */
  transparentNav?: boolean;
}

const {
  title,
  description = 'Your youth baseball journey lives here.',
  activeNav,
  bodyClass,
  transparentNav = false,
} = Astro.props;

// Phase 2 pages reachable by URL but invisible to search engines during Phase 1.
const hideFromSearch = isPageHidden(Astro.url.pathname);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Unrivaled Baseball</title>
    <meta name="description" content={description} />
    {hideFromSearch && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Set motion-js *before* paint so the CSS image fade-in rule applies
        from the first frame. Kept tiny so it doesn't delay anything. */}
    <script is:inline>document.documentElement.classList.add('motion-js');</script>
  </head>
  <body class={bodyClass} data-transparent-nav={transparentNav ? 'true' : undefined}>
    <SiteHeader activeNav={activeNav} />
    <main>
      <slot />
    </main>
    <SiteFooter />
    {/* Motion handlers — Waves 1 & 2.
        Wave 1: image fade-in (mark <img> as .is-loaded once decoded).
        Wave 2: progressive reveal (add .is-revealed to elements with
                data-reveal / data-reveal-stagger as they enter the viewport).
        Wave 3 will add a parallax rAF loop here. */}
    <script is:inline>
      (function () {
        // ----- Wave 1: image fade-in -----
        function markLoaded(img) { img.classList.add('is-loaded'); }
        function initImages() {
          var imgs = document.querySelectorAll('img');
          for (var i = 0; i < imgs.length; i++) {
            var img = imgs[i];
            if (img.complete && img.naturalWidth > 0) {
              markLoaded(img);
            } else {
              img.addEventListener('load',  function () { markLoaded(this); }, { once: true });
              img.addEventListener('error', function () { markLoaded(this); }, { once: true });
            }
          }
        }

        // ----- Wave 2: progressive reveal -----
        function initReveal() {
          var targets = document.querySelectorAll('[data-reveal], [data-reveal-stagger]');
          if (!targets.length) return;
          // Fallback for old browsers: just show everything immediately.
          if (!('IntersectionObserver' in window)) {
            for (var i = 0; i < targets.length; i++) targets[i].classList.add('is-revealed');
            return;
          }
          var observer = new IntersectionObserver(function (entries) {
            for (var i = 0; i < entries.length; i++) {
              if (entries[i].isIntersecting) {
                entries[i].target.classList.add('is-revealed');
                observer.unobserve(entries[i].target);
              }
            }
          }, {
            // Trigger when the element is ~50px into the viewport from the
            // bottom — gives the animation a beat of runway before the user
            // notices it.
            rootMargin: '0px 0px -50px 0px',
            threshold: 0
          });
          for (var j = 0; j < targets.length; j++) observer.observe(targets[j]);
        }

        function init() {
          initImages();
          initReveal();
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
      })();
    </script>
  </body>
</html>
