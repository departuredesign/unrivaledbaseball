---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/v4-pillar.css';

const QUALIFIERS = [
  { mon: 'MAY', day: '17', title: 'UBN Mid-Atlantic Qualifier', cat: 'Qualifying Ladder · 12U', loc: 'Aberdeen, MD',  age: '12U' },
  { mon: 'JUN', day: '14', title: 'UBN Southeast Championship',  cat: 'Qualifying Ladder · 12U', loc: 'Atlanta, GA',   age: '12U' },
  { mon: 'JUN', day: '30', title: 'Ripken National Championships', cat: 'Championship Round · Cooperstown', loc: 'Cooperstown, NY', age: '12U' },
];

const CROSS_SELL = [
  { tag: 'LOCAL TOURNAMENTS', name: 'UBN Qualifying Network', meta: 'Earn your way through regional play', href: '/local/' },
  { tag: 'DESTINATIONS',      name: 'Cooperstown',            meta: 'The championship setting',           href: '/cooperstown/' },
  { tag: 'TRAINING',          name: 'All-Ripken Games',       meta: 'Top players by class',               href: '/all-ripken/' },
];
---

<BaseLayout title="Ripken Nationals" activeNav="ways-to-play" bodyClass="v4">
  <div class="pillar-page" data-pillar="nationals">

    <section class="phv4">
      <div class="phv4__bg" style="background-image:url('/images/v4/photo-celebrate.png')" aria-hidden="true"></div>
      <div class="phv4__overlay" aria-hidden="true"></div>
      <div class="phv4__inner">
        <p class="phv4__eyebrow text-eyebrow">UNRIVALED BASEBALL / RIPKEN NATIONALS</p>
        <span class="phv4__chip">NATIONALS · CHAMPIONSHIP</span>
        <h1 class="phv4__headline">A pinnacle moment.</h1>
        <p class="phv4__sub">Sixteen of the best teams in each class meet at Cooperstown for the championship round of the youth baseball year.</p>
      </div>
    </section>

    <section class="ubn-x">
      <div class="ubn-x__inner">
        <div>
          <p class="ubn-x__eyebrow text-eyebrow">THE CHAMPIONSHIP</p>
          <h2 class="ubn-x__headline">Sixteen teams. One title.</h2>
          <p class="ubn-x__body text-body">The Ripken Nationals is the championship round of the Unrivaled portfolio — a 16-team invitational at Cooperstown All Star Village. Teams qualify through the UBN ladder or by direct invitation.</p>
          <ul class="ubn-x__bullets">
            <li class="text-body-sm">16-team bracket, single class.</li>
            <li class="text-body-sm">Hosted at Cooperstown All Star Village.</li>
            <li class="text-body-sm">Two pathways to qualify — the ladder or a direct bid.</li>
          </ul>
        </div>
        <div class="ubn-x__aside">
          <div class="ubn-x__stat"><span class="ubn-x__stat-num">16</span><span class="ubn-x__stat-label">Teams per class</span></div>
          <div class="ubn-x__stat"><span class="ubn-x__stat-num">1</span><span class="ubn-x__stat-label">National title</span></div>
          <div class="ubn-x__stat"><span class="ubn-x__stat-num">20+</span><span class="ubn-x__stat-label">Years in the making</span></div>
        </div>
      </div>
    </section>

    <section class="pevents">
      <div class="sec__inner">
        <h2 class="sec__headline">The road to Cooperstown.</h2>
        {QUALIFIERS.map(e => (
          <div class="evrow">
            <span class="evrow__date"><span class="evrow__mon">{e.mon}</span><span class="evrow__day">{e.day}</span></span>
            <span class="evrow__main"><h3 class="evrow__title">{e.title}</h3><span class="evrow__cat">{e.cat} · {e.age}</span></span>
            <span class="evrow__loc">{e.loc}</span>
            <a class="evrow__reg" href="/events/">Register →</a>
          </div>
        ))}
      </div>
    </section>

    <section class="xsell">
      <div class="xsell__inner">
        <p class="xsell__eyebrow text-eyebrow">CONTINUE THE JOURNEY</p>
        <h2 class="xsell__headline">More ways to play.</h2>
        <div class="xsell__grid">
          {CROSS_SELL.map(c => (
            <a class="xcard" href={c.href}>
              <span class="xcard__tag">{c.tag}</span>
              <h3 class="xcard__name">{c.name}</h3>
              <p class="xcard__meta">{c.meta}</p>
              <span class="xcard__arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="ctaband">
      <div class="ctaband__inner">
        <h2 class="ctaband__headline">Find a qualifier.</h2>
        <a class="ctaband__btn" href="/events/">Find a qualifier →</a>
      </div>
    </section>

  </div>
</BaseLayout>
