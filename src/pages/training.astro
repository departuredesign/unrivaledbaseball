---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/v4-pillar.css';

const PROGRAMS = [
  { name: 'Baseball Factory', count: 'EVALUATIONS · CAMPS', line: 'Where players unlock their full potential.',     href: '/baseball-factory/', photo: '/images/v4/photo-batter.png' },
  { name: 'All-Ripken Games', count: 'INVITATION ONLY',     line: 'Where the best players in each class meet.',      href: '/all-ripken/',       photo: '/images/v4/photo-celebrate.png' },
  { name: 'Prospect Select',  count: '14U–16U SHOWCASE',    line: 'Where middle school becomes high school.',        href: '/prospect-select/',  photo: '/images/v4/photo-pitcher.png' },
  { name: 'Spring Training',  count: 'PRESEASON WEEK',      line: 'Where the season starts.',                       href: '/spring-training/',  photo: '/images/v4/photo-field.png' },
];

const CROSS_SELL = [
  { tag: 'LOCAL TOURNAMENTS', name: 'UBN Weekend Play',  meta: 'Sanctioned tournament play', href: '/local/' },
  { tag: 'DESTINATIONS',      name: 'Ripken Experience', meta: 'Big-league weeklong play',   href: '/ripken-aberdeen/' },
  { tag: 'NATIONALS',         name: 'Ripken Nationals',  meta: 'The championship round',     href: '/nationals/' },
];
---

<BaseLayout title="Training & Development" activeNav="ways-to-play" bodyClass="v4" transparentNav={true}>
  <div class="pillar-page" data-pillar="training">

    <section class="phv4">
      <div class="phv4__bg" style="background-image:url('/images/v4/photo-pitcher.png')" aria-hidden="true"></div>
      <div class="phv4__overlay" aria-hidden="true"></div>
      <div class="phv4__inner">
        <p class="phv4__eyebrow text-eyebrow">UNRIVALED BASEBALL / TRAINING &amp; DEVELOPMENT</p>
        <span class="phv4__chip">TRAINING</span>
        <h1 class="phv4__headline">Where players become prospects.</h1>
        <p class="phv4__sub">Evaluation, instruction, showcase, exposure — the development side of the Unrivaled portfolio.</p>
      </div>
    </section>

    <section class="regions sec">
      <div class="sec__inner" style="display:flex;flex-direction:column;">
        <p class="sec__eyebrow text-eyebrow" style="color:var(--gray-500)">OUR PROGRAMS</p>
        <h2 class="sec__headline">Every step of the pathway.</h2>
        <div class="regions__grid">
          {PROGRAMS.map(p => (
            <a class="region-card" href={p.href}>
              <span class="region-card__bar" aria-hidden="true"></span>
              <span class="region-card__photo" style={`background-image:url('${p.photo}')`} aria-hidden="true"></span>
              <span class="region-card__body">
                <span class="region-card__tag">DEVELOPMENT</span>
                <h3 class="region-card__name">{p.name}</h3>
                <span class="region-card__count">{p.count}</span>
                <p class="region-card__states">{p.line}</p>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="xsell">
      <div class="xsell__inner">
        <p class="xsell__eyebrow text-eyebrow">CONTINUE THE JOURNEY</p>
        <h2 class="xsell__headline">More ways to play.</h2>
        <div class="xsell__grid">
          {CROSS_SELL.map(c => (
            <a class="xcard" href={c.href}>
              <span class="xcard__tag">{c.tag}</span>
              <h3 class="xcard__name">{c.name}</h3>
              <p class="xcard__meta">{c.meta}</p>
              <span class="xcard__arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="ctaband">
      <div class="ctaband__inner">
        <h2 class="ctaband__headline">Find your next step.</h2>
        <a class="ctaband__btn" href="/events/">Browse evaluations →</a>
      </div>
    </section>

  </div>
</BaseLayout>
