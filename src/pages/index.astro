---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/heroes/Hero.astro';
import Ticker from '../components/sections/Ticker.astro';
import PillarCard from '../components/cards/PillarCard.astro';
import Manifesto from '../components/sections/Manifesto.astro';
import FeaturedRail from '../components/sections/FeaturedRail.astro';
import FindYourPath from '../components/sections/FindYourPath.astro';
import VoicesModule from '../components/sections/VoicesModule.astro';

const pillars = [
  { pillar: 'local' as const,        num: '01', name: 'Local Tournaments',       desc: 'UBN · USSSA-Sanctioned Play',              href: '/local/' },
  { pillar: 'destinations' as const, num: '02', name: 'Destinations',            desc: 'Weeklong at our properties',                href: '/destinations/' },
  { pillar: 'nationals' as const,    num: '03', name: 'Nationals',               desc: '16-team championship · Cooperstown',        href: '/nationals/' },
  { pillar: 'training' as const,     num: '04', name: 'Training',                desc: 'Baseball Factory · Prospect Select',        href: '/training/' },
];

const tickerItems = [
  { text: 'Ripken National Championships — Aberdeen, MD — Jul 12' },
  { text: 'Prospect Select Showcase — Las Vegas — Jul 18' },
  { text: 'Cooperstown Week 7 Tournament — Aug 3' },
  { text: 'Baseball Factory Eval — Manteca, CA — Aug 9' },
];

const featured = [
  { pillar: 'destinations' as const, parentTag: 'DESTINATION EXPERIENCES', title: 'Ripken National Championships', meta: 'Jul 12-19 · Aberdeen, MD', href: '/nationals/' },
  { pillar: 'training' as const,     parentTag: 'TRAINING & DEVELOPMENT',  title: 'Prospect Select Las Vegas',     meta: 'Jul 18 · 14U-16U',         href: '/prospect-select/' },
  { pillar: 'destinations' as const, parentTag: 'DESTINATION EXPERIENCES', title: 'Cooperstown Week 7',            meta: 'Aug 3-9 · 11U-12U',        href: '/cooperstown/' },
];

const testimonials = [
  { quote: 'This is the first place where my son felt like he was part of something bigger.', attribution: 'Parent · Massachusetts' },
  { quote: "You see the kids walk in on day one, and you see them walk out on day seven. They're different.", attribution: 'Coach · Texas' },
  { quote: 'I played here in 2019. Came back five years later as staff. The place stays with you.', attribution: 'Alum · 2019' },
];
---

<BaseLayout title="Home" activeNav="home">
  <Hero
    headline="Your youth baseball journey lives here."
    sub="Pinnacle moments across the journey, all under one banner."
  />

  <Ticker items={tickerItems} />

  <section class="portfolio">
    <div class="portfolio__inner">
      <p class="portfolio__eyebrow text-eyebrow">WAYS TO PLAY</p>
      <h2 class="portfolio__headline text-h1">One brand across the entire arc of the journey.</h2>
      <div class="portfolio__grid">
        {pillars.map(p => <PillarCard {...p} />)}
      </div>
    </div>
  </section>

  <Manifesto
    headline="Pinnacle moments across the journey."
    body="From a first weekend tournament to a 12U championship at Cooperstown — the journey lives here."
  />

  <FeaturedRail items={featured} />

  <FindYourPath />

  <section class="testimonials">
    <div class="testimonials__inner">
      <p class="testimonials__eyebrow text-eyebrow">TESTIMONIALS</p>
      <h2 class="testimonials__headline text-h1">Unrivaled Baseball in their own words.</h2>
      <VoicesModule voices={testimonials} eyebrow="" headline="" />
    </div>
  </section>

  <section class="partners">
    <p class="partners__label text-eyebrow">Our Partners</p>
    <div class="partners__row">
      {Array.from({ length: 6 }, () => <div class="partners__cell" aria-hidden="true"></div>)}
    </div>
  </section>
</BaseLayout>

<style>
  .portfolio {
    background: var(--color-white);
  }
  .portfolio__inner {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 80px var(--margin-mobile);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  @media (min-width: 1024px) {
    .portfolio__inner { padding: 100px var(--margin-desktop); }
  }
  .portfolio__eyebrow { color: var(--gray-500); }
  .portfolio__headline { color: var(--color-black); max-width: 800px; }
  .portfolio__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    margin-top: 24px;
  }
  @media (min-width: 640px) {
    .portfolio__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .portfolio__grid { grid-template-columns: repeat(4, 1fr); }
  }

  .testimonials {
    background: var(--color-navy);
    color: var(--color-white);
  }
  .testimonials__inner {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 80px var(--margin-mobile);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  @media (min-width: 1024px) {
    .testimonials__inner { padding: 100px var(--margin-desktop); }
  }
  .testimonials__eyebrow { color: var(--color-gold); }
  .testimonials__headline { color: var(--color-white); }
  .testimonials :global(.voices-module) {
    background: transparent;
  }
  .testimonials :global(.voices-module__inner) {
    padding: 0;
  }
  .testimonials :global(.voice-card) {
    background: rgba(255, 255, 255, 0.05);
    color: var(--color-white);
  }
  .testimonials :global(.voice-card__quote) {
    color: var(--color-white);
  }
  .testimonials :global(.voice-card__attr) {
    color: rgba(255, 255, 255, 0.6);
  }

  .partners {
    background: var(--color-white);
    padding: 60px var(--margin-mobile);
    text-align: center;
  }
  @media (min-width: 1024px) {
    .partners { padding: 80px var(--margin-desktop); }
  }
  .partners__label {
    color: var(--gray-500);
    margin-bottom: 24px;
  }
  .partners__row {
    max-width: var(--content-max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  @media (min-width: 768px) {
    .partners__row { grid-template-columns: repeat(6, 1fr); }
  }
  .partners__cell {
    aspect-ratio: 5 / 2;
    background: var(--gray-100);
    border: 1px solid var(--gray-200);
  }
</style>
