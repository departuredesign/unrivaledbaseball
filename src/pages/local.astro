---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/v4-pillar.css';
import '../styles/v4-extra.css';

const REGIONS = [
  { name: 'Northeast',     count: '5 STATES', states: 'Massachusetts · Connecticut · New York · New Jersey · Pennsylvania', photo: '/images/v4/photo-flags.png' },
  { name: 'Mid-Atlantic',  count: '4 STATES', states: 'Maryland · Delaware · Washington DC · Virginia',                    photo: '/images/v4/photo-dugout.png' },
  { name: 'Southeast',     count: '5 STATES', states: 'Georgia · North Carolina · South Carolina · Florida · Tennessee',   photo: '/images/v4/photo-running.png' },
  { name: 'Midwest',       count: '4 STATES', states: 'Ohio · Michigan · Indiana · Illinois',                              photo: '/images/v4/photo-batter.png' },
  { name: 'Mountain West', count: '4 STATES', states: 'Colorado · Utah · New Mexico · Arizona',                            photo: '/images/v4/photo-pitcher.png' },
  { name: 'West Coast',    count: '4 STATES', states: 'California · Oregon · Washington · Nevada',                         photo: '/images/v4/photo-field.png' },
];

const EVENTS = [
  { mon: 'JUN', day: '07', title: 'UBN Mid-Atlantic Spring Classic', cat: 'Local & Regional · UBN Network', loc: 'Baltimore, MD',  age: '10U–14U' },
  { mon: 'JUN', day: '23', title: 'UBN Northeast Summer Qualifier',  cat: 'Local & Regional · UBN Network', loc: 'Flemington, NJ', age: '10U–14U' },
  { mon: 'JUL', day: '12', title: 'UBN Southeast Championship',      cat: 'Local & Regional · UBN Network', loc: 'Atlanta, GA',    age: '12U' },
  { mon: 'JUL', day: '26', title: 'UBN Midwest Open',                cat: 'Local & Regional · UBN Network', loc: 'Columbus, OH',   age: '10U–16U' },
];

const CROSS_SELL = [
  { tag: 'DESTINATIONS',           name: 'Destinations',           meta: 'Weeklong tournaments at our properties',  href: '/destinations/' },
  { tag: 'RIPKEN',                 name: 'Ripken',                 meta: 'Experiences · Nationals · All-Ripken',    href: '/ripken/' },
  { tag: 'TRAINING & DEVELOPMENT', name: 'Training & Development', meta: 'Baseball Factory · Prospect Select',       href: '/training/' },
];
---

<BaseLayout title="Local Tournaments" activeNav="ways-to-play" bodyClass="v4" transparentNav={true}>
  <div class="pillar-page" data-pillar="local">

    <section class="phv4">
      <div class="phv4__bg" style="background-image:url('/images/v4/photo-flags.png')" aria-hidden="true"></div>
      <div class="phv4__overlay" aria-hidden="true"></div>
      <div class="phv4__inner">
        <p class="phv4__eyebrow text-eyebrow">UNRIVALED BASEBALL / LOCAL AND REGIONAL WEEKEND TOURNAMENTS</p>
        <span class="phv4__chip">LOCAL &amp; REGIONAL</span>
        <h1 class="phv4__headline">National footprint. Local roots.</h1>
        <p class="phv4__sub">Competitive youth baseball tournaments, elite high-school events, and player-development weekends. In 16 states and growing.</p>
        <div class="phv4__stats">
          <div><span class="phv4__stat-label">STATES</span><span class="phv4__stat-val">16 active nationwide</span></div>
          <div><span class="phv4__stat-label">LEVELS</span><span class="phv4__stat-val">Youth · High School · Development</span></div>
          <div><span class="phv4__stat-label">SEASON</span><span class="phv4__stat-val">Tournaments all year</span></div>
        </div>
      </div>
    </section>

    <section class="ubn-x" data-reveal>
      <div class="ubn-x__inner">
        <div>
          <p class="ubn-x__eyebrow text-eyebrow">WHAT IS UBN</p>
          <h2 class="ubn-x__headline">Sanctioned weekend play, region by region.</h2>
          <p class="ubn-x__body text-body">The Unrivaled Baseball Network is the regional weekend tournament circuit inside Unrivaled. Every event runs under USSSA rules, with a qualifying ladder that leads toward Ripken Nationals.</p>
          <ul class="ubn-x__bullets">
            <li class="text-body-sm">Built on the UBN qualifying ladder.</li>
            <li class="text-body-sm">Year-round play across every region.</li>
            <li class="text-body-sm">One standard, one schedule, one brand.</li>
          </ul>
        </div>
        <div class="ubn-x__aside">
          <div class="ubn-x__stat"><span class="ubn-x__stat-num">16</span><span class="ubn-x__stat-label">States active nationwide</span></div>
          <div class="ubn-x__stat"><span class="ubn-x__stat-num">200+</span><span class="ubn-x__stat-label">Sanctioned weekend events</span></div>
          <div class="ubn-x__stat"><span class="ubn-x__stat-num">10U–16U</span><span class="ubn-x__stat-label">Age divisions</span></div>
        </div>
      </div>
    </section>

    <section class="ngallery" data-reveal>
      <div class="ngallery__inner">
        <p class="ngallery__eyebrow text-eyebrow">THE UBN NETWORK</p>
        <h2 class="ngallery__headline">Weekend baseball, coast to coast.</h2>
        <div class="ngallery__grid" data-reveal-stagger>
          {['dust and dugouts', 'a walk-off win', 'opening Saturday', 'the bracket board', 'trophy presentation'].map((cap, i) => (
            <span class="ngallery__tile" style={`background-image:url('${['/images/v4/photo-flags.png','/images/v4/photo-running.png','/images/v4/photo-batter.png','/images/v4/photo-pitcher.png','/images/v4/photo-celebrate.png'][i]}')`}><span class="ngallery__cap">[ {cap} ]</span></span>
          ))}
        </div>
      </div>
    </section>

    <section class="regions sec" data-reveal>
      <div class="sec__inner" style="display:flex;flex-direction:column;">
        <p class="sec__eyebrow text-eyebrow" style="color:var(--gray-500)">OUR REGIONS</p>
        <h2 class="sec__headline">Local play. Regional reach.</h2>
        <div class="regions__grid" data-reveal-stagger>
          {REGIONS.map(r => (
            <a class="region-card" href="/events/">
              <span class="region-card__bar" aria-hidden="true"></span>
              <span class="region-card__photo" style={`background-image:url('${r.photo}')`} aria-hidden="true"></span>
              <span class="region-card__body">
                <span class="region-card__tag">UBN NETWORK</span>
                <h3 class="region-card__name">{r.name}</h3>
                <span class="region-card__count">{r.count}</span>
                <p class="region-card__states">{r.states}</p>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="pevents" data-reveal>
      <div class="sec__inner">
        <h2 class="sec__headline">Upcoming local events.</h2>
        {EVENTS.map(e => (
          <div class="evrow">
            <span class="evrow__date"><span class="evrow__mon">{e.mon}</span><span class="evrow__day">{e.day}</span></span>
            <span class="evrow__main"><h3 class="evrow__title">{e.title}</h3><span class="evrow__cat">{e.cat} · {e.age}</span></span>
            <span class="evrow__loc">{e.loc}</span>
            <a class="evrow__reg" href="/events/">Register →</a>
          </div>
        ))}
      </div>
    </section>

    <section class="xsell" data-reveal>
      <div class="xsell__inner">
        <p class="xsell__eyebrow text-eyebrow">CONTINUE THE JOURNEY</p>
        <h2 class="xsell__headline">More ways to play.</h2>
        <div class="xsell__grid" data-reveal-stagger>
          {CROSS_SELL.map(c => (
            <a class="xcard" href={c.href}>
              <span class="xcard__tag">{c.tag}</span>
              <h3 class="xcard__name">{c.name}</h3>
              <p class="xcard__meta">{c.meta}</p>
              <span class="xcard__arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="ctaband" data-reveal>
      <div class="ctaband__inner">
        <h2 class="ctaband__headline">Find a weekend near you.</h2>
        <a class="ctaband__btn" href="/events/">See all events →</a>
      </div>
    </section>

  </div>
</BaseLayout>
