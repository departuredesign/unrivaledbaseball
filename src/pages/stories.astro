---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/v4-pillar.css';
import '../styles/v4-listing.css';

const CHIPS = ['All Stories', 'Athletes', 'Development', 'Nationals', 'Press'];

const STORIES = [
  { category: 'FEATURED · ATHLETE',    title: 'A long road from a Northeast UBN field to Cooperstown.',          byline: 'Editorial · 5 min read', href: '/stories/long-road/',        photo: '/images/v4/photo-running.png' },
  { category: 'INSIDE · NATIONALS',    title: 'Behind the scenes at Ripken Aberdeen during Nationals week.',     byline: 'Editorial · 4 min read', href: '/stories/inside-nationals/', photo: '/images/v4/photo-celebrate.png' },
  { category: 'PRESS · BROADCAST',     title: 'Unrivaled Baseball announces broadcast partnership with CBS.',    byline: 'Press · 2 min read',     href: '#',                          photo: '/images/v4/photo-flags.png' },
  { category: 'PARENT · GUIDE',        title: 'What every parent should pack for a week at Cooperstown.',        byline: 'Editorial · 6 min read', href: '#',                          photo: '/images/v4/photo-dugout.png' },
  { category: 'DEVELOPMENT · PITCHER', title: "A 12U pitcher's journey through the developmental ladder.",       byline: 'Editorial · 7 min read', href: '#',                          photo: '/images/v4/photo-pitcher.png' },
  { category: 'INSIDE · ROCKER B',     title: 'How Rocker B Ranch is rewriting the Texas baseball week.',        byline: 'Editorial · 5 min read', href: '#',                          photo: '/images/v4/photo-batter.png' },
];
---

<BaseLayout title="Stories" activeNav="stories" bodyClass="v4">
  <div class="pillar-page" data-pillar="local">

    <section class="phv4">
      <div class="phv4__bg" style="background-image:url('/images/v4/photo-celebrate.png')" aria-hidden="true"></div>
      <div class="phv4__overlay" aria-hidden="true"></div>
      <div class="phv4__inner">
        <p class="phv4__eyebrow text-eyebrow">UNRIVALED BASEBALL / STORIES</p>
        <span class="phv4__chip">STORIES</span>
        <h1 class="phv4__headline">From the field, in their own words.</h1>
        <p class="phv4__sub">Athletes, families, coaches, and alumni — the people who make the Unrivaled journey what it is.</p>
      </div>
    </section>

    <section class="fbar">
      <div class="fbar__inner">
        {CHIPS.map((c, i) => <a class="fchip" class:list={[{ 'is-active': i === 0 }]} href="#">{c}</a>)}
      </div>
    </section>

    <section class="regions sec">
      <div class="sec__inner" style="display:flex;flex-direction:column;">
        <p class="sec__eyebrow text-eyebrow" style="color:var(--gray-500)">FEATURED STORIES</p>
        <h2 class="sec__headline">From across the portfolio.</h2>
        <div class="regions__grid">
          {STORIES.map(s => (
            <a class="region-card" href={s.href}>
              <span class="region-card__bar" aria-hidden="true"></span>
              <span class="region-card__photo" style={`background-image:url('${s.photo}')`} aria-hidden="true"></span>
              <span class="region-card__body">
                <span class="region-card__tag">{s.category}</span>
                <h3 class="region-card__name">{s.title}</h3>
                <span class="region-card__count">{s.byline}</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="ctaband">
      <div class="ctaband__inner">
        <h2 class="ctaband__headline">Be part of the next story.</h2>
        <a class="ctaband__btn" href="/events/">Find your event →</a>
      </div>
    </section>

  </div>
</BaseLayout>
