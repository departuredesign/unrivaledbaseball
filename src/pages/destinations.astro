---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/v4-pillar.css';

const PROPERTIES = [
  { name: 'Cooperstown All Star Village',     count: 'ONEONTA, NY',     line: 'A pilgrimage at the birthplace of baseball. 12 summer weeks.', href: '/cooperstown/',                    photo: '/images/v4/photo-dugout.png' },
  { name: 'Rocker B Ranch',                   count: 'GRAFORD, TX',     line: 'The 325-acre Texas ranch built for baseball memories.',       href: '/rocker-b/',                       photo: '/images/v4/photo-flags.png' },
  { name: 'Ripken Experience · Aberdeen',     count: 'ABERDEEN, MD',    line: 'Where the Ripken family started. Replica big-league fields.', href: '/ripken-aberdeen/',                photo: '/images/v4/photo-celebrate.png' },
  { name: 'Ripken Experience · Myrtle Beach', count: 'MYRTLE BEACH, SC', line: 'The baseball vacation built into the season.',               href: '/ripken-myrtle-beach/',            photo: '/images/v4/photo-running.png' },
  { name: 'Ripken Experience · Pigeon Forge', count: 'PIGEON FORGE, TN', line: 'Big-league baseball in the foothills of the Smokies.',       href: '/ripken-pigeon-forge/',            photo: '/images/v4/photo-batter.png' },
  { name: 'Sports Force Parks · Cedar Point', count: 'SANDUSKY, OH',    line: 'Where baseball week meets Cedar Point week.',                 href: '/sports-force-parks-cedar-point/', photo: '/images/v4/photo-field.png' },
];

const CROSS_SELL = [
  { tag: 'LOCAL TOURNAMENTS',      name: 'Local Tournaments',       meta: 'USSSA-sanctioned weekends',          href: '/local/' },
  { tag: 'RIPKEN',                 name: 'Ripken',                  meta: 'Experiences · Nationals · All-Ripken', href: '/ripken/' },
  { tag: 'TRAINING & DEVELOPMENT', name: 'Training & Development',  meta: 'Baseball Factory · Prospect Select',  href: '/training/' },
];
---

<BaseLayout title="Destination Experiences" activeNav="ways-to-play" bodyClass="v4" transparentNav={true}>
  <div class="pillar-page" data-pillar="destinations">

    <section class="phv4">
      <div class="phv4__bg" style="background-image:url('/images/v4/photo-dugout.png')" aria-hidden="true"></div>
      <div class="phv4__overlay" aria-hidden="true"></div>
      <div class="phv4__inner">
        <p class="phv4__eyebrow text-eyebrow">UNRIVALED BASEBALL / DESTINATION EXPERIENCES</p>
        <span class="phv4__chip">DESTINATIONS</span>
        <h1 class="phv4__headline">Where families travel to play.</h1>
        <p class="phv4__sub">Weeklong tournaments at premier properties — Cooperstown, the Ripken Experience, Rocker B Ranch, and Sports Force Parks.</p>
      </div>
    </section>

    <section class="regions sec">
      <div class="sec__inner" style="display:flex;flex-direction:column;">
        <p class="sec__eyebrow text-eyebrow" style="color:var(--gray-500)">OUR PROPERTIES</p>
        <h2 class="sec__headline">Where the season becomes a trip.</h2>
        <div class="regions__grid">
          {PROPERTIES.map(p => (
            <a class="region-card" href={p.href}>
              <span class="region-card__bar" aria-hidden="true"></span>
              <span class="region-card__photo" style={`background-image:url('${p.photo}')`} aria-hidden="true"></span>
              <span class="region-card__body">
                <span class="region-card__tag">DESTINATION</span>
                <h3 class="region-card__name">{p.name}</h3>
                <span class="region-card__count">{p.count}</span>
                <p class="region-card__states">{p.line}</p>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="xsell">
      <div class="xsell__inner">
        <p class="xsell__eyebrow text-eyebrow">CONTINUE THE JOURNEY</p>
        <h2 class="xsell__headline">More ways to play.</h2>
        <div class="xsell__grid">
          {CROSS_SELL.map(c => (
            <a class="xcard" href={c.href}>
              <span class="xcard__tag">{c.tag}</span>
              <h3 class="xcard__name">{c.name}</h3>
              <p class="xcard__meta">{c.meta}</p>
              <span class="xcard__arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="ctaband">
      <div class="ctaband__inner">
        <h2 class="ctaband__headline">Ready to find your week?</h2>
        <a class="ctaband__btn" href="/events/">Browse destinations →</a>
      </div>
    </section>

  </div>
</BaseLayout>
