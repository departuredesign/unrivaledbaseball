---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/v4-pillar.css';

// 7-property order + content matches wireframe exactly.
// Card format: city/location is the headline, state is the subhead,
// sub-brand is the bottom line (e.g. COOPERSTOWN / NEW YORK / All Star Village).
const PROPERTIES = [
  { name: 'Cooperstown',  count: 'NEW YORK',       line: 'All Star Village',  href: '/cooperstown/',                    photo: '/images/v4/photo-dugout.png' },
  { name: 'Rocker B',     count: 'TEXAS',          line: 'Rocker B Ranch',    href: '/rocker-b/',                       photo: '/images/v4/photo-flags.png' },
  { name: 'Cedar Point',  count: 'OHIO',           line: 'Sports Parks',      href: '/sports-force-parks-cedar-point/', photo: '/images/v4/photo-field.png' },
  { name: 'Manteca',      count: 'CALIFORNIA',     line: 'Sports Parks',      href: '/sports-force-parks-manteca/',     photo: '/images/v4/photo-glove.png' },
  { name: 'Aberdeen',     count: 'MARYLAND',       line: 'Ripken Experience', href: '/ripken-aberdeen/',                photo: '/images/v4/photo-celebrate.png' },
  { name: 'Myrtle Beach', count: 'SOUTH CAROLINA', line: 'Ripken Experience', href: '/ripken-myrtle-beach/',            photo: '/images/v4/photo-running.png' },
  { name: 'Pigeon Forge', count: 'TENNESSEE',      line: 'Ripken Experience', href: '/ripken-pigeon-forge/',            photo: '/images/v4/photo-batter.png' },
];

// Cross-sell points at specific sub-programs (matches wireframe), not pillar pages.
const CROSS_SELL = [
  { tag: 'DESTINATION EXPERIENCES', name: 'Ripken Experience Weeks',     meta: 'Weeklong tournaments at three iconic sites.',     href: '/ripken-aberdeen/' },
  { tag: 'LOCAL & REGIONAL',        name: 'UBN Network',                 meta: 'Tournaments built around your home region.',      href: '/local/' },
  { tag: 'TRAINING & DEVELOPMENT',  name: 'Prospect Select Showcases',   meta: 'Hosted at our destinations. Open to invited talent.', href: '/prospect-select/' },
];
---

<BaseLayout title="Destination Experiences" activeNav="ways-to-play" bodyClass="v4" transparentNav={true}>
  <div class="pillar-page" data-pillar="destinations">

    <section class="phv4">
      <div class="phv4__bg" style="background-image:url('/images/v4/photo-dugout.png')" aria-hidden="true"></div>
      <div class="phv4__overlay" aria-hidden="true"></div>
      <div class="phv4__inner">
        <p class="phv4__eyebrow text-eyebrow">UNRIVALED BASEBALL / DESTINATION EXPERIENCES</p>
        <span class="phv4__chip">DESTINATION EXPERIENCES</span>
        <h1 class="phv4__headline">Where families travel to play.</h1>
        <p class="phv4__sub">Cooperstown and the three Ripken Experience cities anchor our weeklong programming. Rocker B Ranch and Unrivaled Sports Parks bring weekend tournaments to premier facilities. Every property runs to a single standard.</p>
      </div>
    </section>

    <section class="regions sec" data-reveal>
      <div class="sec__inner" style="display:flex;flex-direction:column;">
        <p class="sec__eyebrow text-eyebrow" style="color:var(--gray-500)">OUR PROPERTIES</p>
        <h2 class="sec__headline">Where the season becomes a trip.</h2>
        <div class="regions__grid" data-reveal-stagger>
          {PROPERTIES.map(p => (
            <a class="region-card" href={p.href}>
              <span class="region-card__bar" aria-hidden="true"></span>
              <span class="region-card__photo" style={`background-image:url('${p.photo}')`} aria-hidden="true"></span>
              <span class="region-card__body">
                <span class="region-card__tag">DESTINATION</span>
                <h3 class="region-card__name">{p.name}</h3>
                <span class="region-card__count">{p.count}</span>
                <p class="region-card__states">{p.line}</p>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="xsell" data-reveal>
      <div class="xsell__inner">
        <p class="xsell__eyebrow text-eyebrow">CONTINUE THE JOURNEY</p>
        <h2 class="xsell__headline">More ways to play.</h2>
        <p class="text-body" style="margin:0 0 24px;opacity:0.85">Other ways your kid can play in the Unrivaled portfolio:</p>
        <div class="xsell__grid" data-reveal-stagger>
          {CROSS_SELL.map(c => (
            <a class="xcard" href={c.href}>
              <span class="xcard__tag">{c.tag}</span>
              <h3 class="xcard__name">{c.name}</h3>
              <p class="xcard__meta">{c.meta}</p>
              <span class="xcard__arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="ctaband" data-reveal hidden>
      <div class="ctaband__inner">
        <h2 class="ctaband__headline">Ready to find what fits?</h2>
        <p style="opacity:0.85;margin:8px 0 24px">Browse the full calendar or start planning the season.</p>
        <a class="ctaband__btn" href="/events/">See all events →</a>
      </div>
    </section>

  </div>
</BaseLayout>
