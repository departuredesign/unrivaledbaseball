---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/v4-pillar.css';
import '../styles/v4-extra.css';

const VENUES = [
  { name: 'Cooperstown All Star Village',     loc: 'Oneonta, NY',      founding: true,  line: 'The original pilgrimage at the birthplace of baseball.', href: '/cooperstown/',                    photo: '/images/v4/photo-dugout.png' },
  { name: 'Ripken Experience · Aberdeen',     loc: 'Aberdeen, MD',     founding: true,  line: "The first Big League Experience — Cal and Bill's hometown.", href: '/ripken-aberdeen/',             photo: '/images/v4/photo-celebrate.png' },
  { name: 'Ripken Experience · Myrtle Beach', loc: 'Myrtle Beach, SC', founding: false, line: 'A baseball vacation a few stoplights from the beach.',  href: '/ripken-myrtle-beach/',            photo: '/images/v4/photo-running.png' },
  { name: 'Ripken Experience · Pigeon Forge', loc: 'Pigeon Forge, TN', founding: false, line: 'Big-league baseball in the foothills of the Smokies.',  href: '/ripken-pigeon-forge/',            photo: '/images/v4/photo-batter.png' },
  { name: 'Rocker B Ranch',                   loc: 'Graford, TX',      founding: false, line: 'A 325-acre Texas ranch built for baseball memories.',   href: '/rocker-b/',                       photo: '/images/v4/photo-flags.png' },
  { name: 'Sports Force Parks · Cedar Point', loc: 'Sandusky, OH',     founding: false, line: 'Where baseball week meets Cedar Point week.',          href: '/sports-force-parks-cedar-point/', photo: '/images/v4/photo-field.png' },
  { name: 'Sports Force Parks · Manteca',     loc: 'Manteca, CA',      founding: false, line: 'A West Coast home for weeklong tournament baseball.',   href: '/sports-force-parks-manteca/',     photo: '/images/v4/photo-pitcher.png' },
];
const founding = VENUES.filter(v => v.founding);
const rest = VENUES.filter(v => !v.founding);
---

<BaseLayout title="Our Venues" activeNav="venues" bodyClass="v4">
  <div class="pillar-page" data-pillar="destinations">

    <section class="phv4">
      <div class="phv4__bg" style="background-image:url('/images/v4/photo-dugout.png')" aria-hidden="true"></div>
      <div class="phv4__overlay" aria-hidden="true"></div>
      <div class="phv4__inner">
        <p class="phv4__eyebrow text-eyebrow">UNRIVALED BASEBALL / OUR VENUES</p>
        <span class="phv4__chip">OUR VENUES</span>
        <h1 class="phv4__headline">The places where the journey lives.</h1>
        <p class="phv4__sub">Every venue in the portfolio runs to the same standard. Some carry the weight of where it all started.</p>
      </div>
    </section>

    <section class="founding sec">
      <div class="sec__inner" style="display:flex;flex-direction:column;">
        <p class="sec__eyebrow text-eyebrow" style="color:var(--color-gold)">★ FOUNDING VENUES</p>
        <h2 class="sec__headline">Where the standard was set.</h2>
        <div class="founding__grid">
          {founding.map(v => (
            <a class="region-card" href={v.href}>
              <span class="region-card__bar" aria-hidden="true"></span>
              <span class="region-card__photo" style={`background-image:url('${v.photo}')`} aria-hidden="true"></span>
              <span class="region-card__body">
                <span class="region-card__tag">★ FOUNDING VENUE</span>
                <h3 class="region-card__name">{v.name}</h3>
                <span class="region-card__count">{v.loc}</span>
                <p class="region-card__states">{v.line}</p>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="regions sec">
      <div class="sec__inner" style="display:flex;flex-direction:column;">
        <p class="sec__eyebrow text-eyebrow" style="color:var(--gray-500)">EVERY VENUE</p>
        <h2 class="sec__headline">Across the portfolio.</h2>
        <div class="regions__grid">
          {rest.map(v => (
            <a class="region-card" href={v.href}>
              <span class="region-card__bar" aria-hidden="true"></span>
              <span class="region-card__photo" style={`background-image:url('${v.photo}')`} aria-hidden="true"></span>
              <span class="region-card__body">
                <span class="region-card__tag">DESTINATION</span>
                <h3 class="region-card__name">{v.name}</h3>
                <span class="region-card__count">{v.loc}</span>
                <p class="region-card__states">{v.line}</p>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

  </div>
</BaseLayout>
