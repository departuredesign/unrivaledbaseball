---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/v4-pillar.css';
import '../styles/v4-listing.css';
import '../styles/v4-extra.css';

const FEATURED = [
  { tag: 'DESTINATION EXPERIENCES', title: 'Ripken National Championships', meta: 'Jul 12–19 · Aberdeen, MD · 12U', href: '/nationals/',        photo: '/images/v4/photo-celebrate.png' },
  { tag: 'TRAINING & DEVELOPMENT',  title: 'Prospect Select Las Vegas',     meta: 'Jul 18 · Las Vegas, NV · 14U–16U', href: '/prospect-select/', photo: '/images/v4/photo-pitcher.png' },
  { tag: 'DESTINATION EXPERIENCES', title: 'Cooperstown Week 7',            meta: 'Aug 3–9 · Cooperstown, NY · 11U–12U', href: '/cooperstown/',  photo: '/images/v4/photo-dugout.png' },
];

const CHIPS = ['All Events', 'Local', 'Destinations', 'Training', 'Nationals'];

const EVENTS = [
  { mon: 'JUN', day: '07', title: 'UBN Mid-Atlantic Spring Classic',   cat: 'Local · UBN Network',         loc: 'Baltimore, MD',   dates: 'Jun 7–9' },
  { mon: 'JUN', day: '23', title: 'Ripken Experience Myrtle Beach Wk 1', cat: 'Destinations · Myrtle Beach', loc: 'Myrtle Beach, SC', dates: 'Jun 23–28' },
  { mon: 'JUL', day: '06', title: 'Baseball Factory Texas Camp',        cat: 'Training · Baseball Factory', loc: 'Dallas, TX',      dates: 'Jul 6–8' },
  { mon: 'JUL', day: '08', title: 'Sports Parks Manteca Showdown',      cat: 'Destinations · Manteca',      loc: 'Manteca, CA',     dates: 'Jul 8–10' },
  { mon: 'JUL', day: '12', title: 'Ripken National Championships',      cat: 'Nationals · Aberdeen',        loc: 'Aberdeen, MD',    dates: 'Jul 12–19' },
  { mon: 'JUL', day: '18', title: 'Prospect Select Las Vegas',          cat: 'Training · Prospect Select',  loc: 'Las Vegas, NV',   dates: 'Jul 18–20' },
  { mon: 'JUL', day: '21', title: 'Rocker B Summer Invitational',       cat: 'Destinations · Rocker B',     loc: 'Andrews, TX',     dates: 'Jul 21–26' },
  { mon: 'AUG', day: '03', title: 'Cooperstown Week 7 Tournament',      cat: 'Destinations · Cooperstown',  loc: 'Cooperstown, NY', dates: 'Aug 3–9' },
];
---

<BaseLayout title="Events" activeNav="events" bodyClass="v4" transparentNav={true}>
  <div class="pillar-page" data-pillar="local">

    <section class="phv4">
      <div class="phv4__bg" style="background-image:url('/images/v4/photo-running.png')" aria-hidden="true"></div>
      <div class="phv4__overlay" aria-hidden="true"></div>
      <div class="phv4__inner">
        <p class="phv4__eyebrow text-eyebrow">UNRIVALED BASEBALL / EVENTS</p>
        <span class="phv4__chip">EVENTS</span>
        <h1 class="phv4__headline">Every Unrivaled event. One calendar.</h1>
        <p class="phv4__sub">Browse the full portfolio — local play, development, weeklong experiences, and elite showcases — across every owned destination.</p>
      </div>
    </section>

    <section class="ngallery">
      <div class="ngallery__inner">
        <p class="ngallery__eyebrow text-eyebrow">FEATURED THIS SEASON</p>
        <h2 class="ngallery__headline">Don't miss these.</h2>
        <div class="regions__grid">
          {FEATURED.map(f => (
            <a class="region-card" href={f.href}>
              <span class="region-card__bar" aria-hidden="true"></span>
              <span class="region-card__photo" style={`background-image:url('${f.photo}')`} aria-hidden="true"></span>
              <span class="region-card__body">
                <span class="region-card__tag">{f.tag}</span>
                <h3 class="region-card__name">{f.title}</h3>
                <span class="region-card__count">{f.meta}</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="fbar">
      <div class="fbar__inner">
        {CHIPS.map((c, i) => <a class="fchip" class:list={[{ 'is-active': i === 0 }]} href="#">{c}</a>)}
      </div>
    </section>

    <section class="pevents">
      <div class="sec__inner">
        <p class="sec__eyebrow text-eyebrow" style="color:var(--gray-500)">UPCOMING — SUMMER 2026 · ALL EVENTS</p>
        {EVENTS.map(e => (
          <div class="evrow">
            <span class="evrow__date"><span class="evrow__mon">{e.mon}</span><span class="evrow__day">{e.day}</span></span>
            <span class="evrow__main"><h3 class="evrow__title">{e.title}</h3><span class="evrow__cat">{e.cat}</span></span>
            <span class="evrow__loc">{e.loc} · {e.dates}</span>
            <a class="evrow__reg" href="#">Register →</a>
          </div>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>
