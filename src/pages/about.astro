---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/v4-pillar.css';
import '../styles/v4-subproperty.css';
import '../styles/v4-extra.css';

const STATS = [
  { num: '20+',  label: 'Years of unforgettable tournaments' },
  { num: '7',    label: 'Destination properties' },
  { num: '12K+', label: 'Teams every summer' },
  { num: '1',    label: 'Standard, end to end' },
];

const PROMISE = [
  { title: 'Communication',          desc: 'Clear, timely, accurate. You always know what is happening with your week.' },
  { title: 'Customer Service',       desc: 'A real person, on the ground, every day — the standard families expect.' },
  { title: 'Standard of Excellence', desc: 'The bar that founded the brand. Every property, every event, every season.' },
];

const TIMELINE = [
  { year: '1985', label: 'Cooperstown All Star Village', detail: 'The original pilgrimage' },
  { year: '1996', label: 'Ripken Experience Aberdeen',   detail: 'The first Big League Experience' },
  { year: '2003', label: 'Ripken Myrtle Beach',          detail: 'Coastal weeklong play' },
  { year: '2011', label: 'Ripken Pigeon Forge',          detail: 'Smoky Mountain baseball' },
  { year: '2022', label: 'Sports Force Parks · Cedar Point', detail: 'Theme-park weekend' },
  { year: '2024', label: 'The Unrivaled portfolio',      detail: 'One name, end to end' },
];

const LEADERSHIP = [
  { name: '[ Name ]', role: 'CEO' },
  { name: '[ Name ]', role: 'President' },
  { name: '[ Name ]', role: 'COO' },
  { name: '[ Name ]', role: 'CMO' },
];
---

<BaseLayout title="About" activeNav="about" bodyClass="v4" transparentNav={true}>
  <div class="pillar-page" data-pillar="local">

    <section class="phv4">
      <div class="phv4__bg" style="background-image:url('/images/v4/hero.png')" aria-hidden="true"></div>
      <div class="phv4__overlay" aria-hidden="true"></div>
      <div class="phv4__inner">
        <p class="phv4__eyebrow text-eyebrow">UNRIVALED BASEBALL / ABOUT</p>
        <span class="phv4__chip">ABOUT UNRIVALED</span>
        <h1 class="phv4__headline">One name across the journey.</h1>
        <p class="phv4__sub">The most trusted names in youth baseball, together under one banner — one standard, one journey.</p>
      </div>
    </section>

    <section class="story" data-reveal>
      <div class="story__inner">
        <div>
          <p class="story__eyebrow text-eyebrow">OUR STORY</p>
          <h2 class="story__headline">Built over decades. Brought together for the next generation.</h2>
          <p class="story__body text-body">Unrivaled Baseball brings the most trusted names in youth baseball — Cooperstown All Star Village, the Ripken Experience, Baseball Factory — together under one banner. One standard. One journey from a kid's first weekend tournament to the national championship round.</p>
        </div>
        <div class="story__photo" style="background-image:url('/images/v4/photo-dugout.png')" aria-hidden="true"></div>
      </div>
    </section>

    <section class="btns" data-reveal>
      <div class="sec__inner" style="display:flex;flex-direction:column;">
        <p class="sec__eyebrow text-eyebrow" style="color:var(--color-gold)">BY THE NUMBERS</p>
        <h2 class="sec__headline" style="color:var(--color-white)">Two decades, one standard.</h2>
        <div class="btns__grid" data-reveal-stagger>
          {STATS.map(s => (
            <div><div class="btns__num">{s.num}</div><div class="btns__label">{s.label}</div></div>
          ))}
        </div>
      </div>
    </section>

    <section class="wte sec" data-reveal>
      <div class="sec__inner" style="display:flex;flex-direction:column;">
        <p class="sec__eyebrow text-eyebrow" style="color:var(--gray-500)">OUR PROMISE</p>
        <h2 class="sec__headline">The standard parents and coaches count on.</h2>
        <div class="wte__grid" data-reveal-stagger style="grid-template-columns:repeat(3,1fr)">
          {PROMISE.map(p => (
            <div class="wte-card"><h3 class="wte-card__title">{p.title}</h3><p class="wte-card__desc">{p.desc}</p></div>
          ))}
        </div>
      </div>
    </section>

    <section class="tline" data-reveal>
      <div class="sec__inner" style="display:flex;flex-direction:column;">
        <p class="sec__eyebrow text-eyebrow" style="color:var(--color-gold)">THE TIMELINE</p>
        <h2 class="sec__headline" style="color:var(--color-white)">Brought together over forty years.</h2>
        {TIMELINE.map(t => (
          <div class="tline__row">
            <span class="tline__year">{t.year}</span>
            <div><h3 class="tline__label">{t.label}</h3><span class="tline__detail">{t.detail}</span></div>
          </div>
        ))}
      </div>
    </section>

    <section class="lead-sec sec" data-reveal>
      <div class="sec__inner" style="display:flex;flex-direction:column;">
        <p class="sec__eyebrow text-eyebrow" style="color:var(--gray-500)">LEADERSHIP</p>
        <h2 class="sec__headline">The team behind the standard.</h2>
        <div class="lead__grid" data-reveal-stagger>
          {LEADERSHIP.map(p => (
            <div><div class="lead-card__photo" aria-hidden="true"></div><div class="lead-card__name">{p.name}</div><div class="lead-card__role">{p.role}</div></div>
          ))}
        </div>
      </div>
    </section>

  </div>
</BaseLayout>
